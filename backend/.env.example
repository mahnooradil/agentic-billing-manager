# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or real secrets.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Allowed CORS origin (the frontend URL)
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string (required).
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Index integrity (see src/config/index-integrity.ts). When "true", every
# model's declared indexes are actively synced (built/dropped) at boot.
# Optional — defaults to off. Enable for one deploy after an index changes,
# then turn off again; the read-only startup check that refuses to boot on a
# missing index always runs regardless of this flag.
SYNC_INDEXES_ON_BOOT=false

# ── Authentication (JWT) ──────────────────────────────────────
# Secret used to sign JWTs (required). Use a long, random value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access-token lifetime, e.g. "1d", "12h", "3600" (defaults to "1d").
JWT_EXPIRES_IN=1d

# ── "Continue with Google" sign-in ─────────────────────────────
# The OAuth 2.0 Client ID from Google Cloud Console (APIs & Services >
# Credentials), with this app's frontend URL added under "Authorized
# JavaScript origins". Only the client id is needed (ID-token verification,
# no client secret). Also set as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend
# .env — same value, both public. Optional — if unset, the button reports
# "not configured" instead of failing.
GOOGLE_CLIENT_ID=

# ── AI provider settings ──────────────────────────────────────
# Secret used to encrypt stored third-party API keys (AES-256-GCM).
# Optional — if unset, a key is derived from JWT_SECRET. For key separation,
# set a dedicated value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENCRYPTION_KEY=

# ── Email (Resend) ────────────────────────────────────────────
# Transactional email — verification codes, support request notifications.
# Optional: if unset, email sending reports "not configured" instead of
# failing the request (OTPs simply won't be delivered).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where support requests are emailed. Optional — falls back to RESEND_FROM_EMAIL.
SUPPORT_INBOX_EMAIL=

# ── Slack (Billing Advisor Agent chat + alerts) ────────────────
# One bot for the whole deployment. Bot token calls the Web API
# (chat.postMessage); signing secret verifies inbound Events API requests.
# Optional — if unset, the Slack chat integration reports "not configured".
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Stripe (Buy Credits) ────────────────────────────────────────
# Lets a workspace purchase additional Billing Advisor credits via Stripe
# Checkout. Optional — if unset, "Buy more credits" reports "not configured".
# Test-mode secret key: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret — from `stripe listen` (prints one) in dev, or the
# Dashboard's webhook endpoint settings in production.
STRIPE_WEBHOOK_SECRET=
